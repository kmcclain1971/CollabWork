<Page x:Class="WaywardHorizons.Menu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WaywardHorizons"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Menu">

    <Grid KeyDown="Grid_KeyDown" Background="#FFC80000">
        <Grid HorizontalAlignment="Left" Height="388" VerticalAlignment="Top" Width="734">
            <Label Content="WAYWARD HORIZONS" HorizontalAlignment="Left" VerticalAlignment="Top" Height="59" Width="374" Uid="mainLabel" FontSize="36" FontFamily="Algerian"/>
            <TextBlock HorizontalAlignment="Left" Margin="108,59,0,0" TextWrapping="Wrap" Text="A game by Conor McClain" VerticalAlignment="Top" Uid="mainSubtitle" Height="16" Width="140"/>
            <TextBlock HorizontalAlignment="Left" Margin="27,177,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="110" Width="303" TextAlignment="Center"><Run Text="Hello! "/><Run Text="My name is Gregory! Allow me to be your guide! Get ready for the Adventure of a lifetime friend!"/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run Text="What is your name brave adventurer?"/></TextBlock>
            <TextBox x:Name="txtName" HorizontalAlignment="Left" Margin="75,325,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="205" Height="28"/>
            <Button Content="Submit" HorizontalAlignment="Left" Margin="216,364,0,0" VerticalAlignment="Top" Height="24" Width="64" Click="Button_Click"/>
            <Image x:Name="Map" Margin="408,67,0,11" Source="/images/MAP.png" Stretch="Fill"/>

        </Grid>

    </Grid>
</Page>
