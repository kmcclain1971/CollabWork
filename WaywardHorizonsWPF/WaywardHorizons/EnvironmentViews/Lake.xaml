<Page x:Class="WaywardHorizons.LakeViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WaywardHorizons"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Lake">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- header row -->
            <RowDefinition Height="15*"/>
            <!-- content row -->
            <RowDefinition Height="75*"/>
            <!-- footer row -->
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/images/LakeLava.png"/>
        </Grid.Background>

        <!-- header title text -->
        <TextBlock x:Name="tbTitle" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="24,1,0,0" TextWrapping="Wrap" Text="Lake Lava" VerticalAlignment="Top" FontSize="48" FontFamily="Algerian" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect/>
            </TextBlock.Effect>
        </TextBlock>
        <!-- header player stats -->
        <TextBlock x:Name="tbPlayerStats" HorizontalAlignment="Left" Margin="28,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Height="37" Width="169" Foreground="White" FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="1">
            <TextBlock.Effect>
                <DropShadowEffect/>
            </TextBlock.Effect>
            <Run Text="Health:"/><LineBreak/><Run Text="Supplies:"/>
        </TextBlock>
        <!-- body - events and actions -->
        <StackPanel x:Name="spEventActions" Grid.Row="1" Grid.Column="0">
            <TextBlock x:Name="tbEvent" TextWrapping="Wrap" Width="374" FontWeight="Bold" FontSize="14" Foreground="White">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect><Run Text="Enter Choice Below..."/></TextBlock>
            <ListBox x:Name="lbEvents" Width="200" Height="200" BorderThickness="0" ItemsSource="{Binding Choices}" Background="{x:Null}" Foreground="White" SelectionChanged="lbEvents_SelectionChanged" Margin="37,58,243,80">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding ChoiceText}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <!-- body - action results -->
        <TextBlock x:Name="tbActionResults" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Foreground="White" Margin="28,10,0,0" Visibility="Hidden">
            <Run Text="Results of stuff go here" />
        </TextBlock>
        <!-- footer -->
        <Button x:Name="btnContinue" Content="Continue Exploring" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Height="34" Width="140" Click="btnContinue_Click" Margin="0,1,0,0" Visibility="Hidden"/>
    </Grid>
</Page>
