<Page x:Class="WaywardHorizons.Lake"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WaywardHorizons"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Lake" Loaded="Page_Loaded">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/images/LakeLava.png"/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="24,17,0,0" TextWrapping="Wrap" Text="Lake Lava" VerticalAlignment="Top" FontSize="48" FontFamily="Algerian" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="586,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="37" Width="169" Foreground="White" FontSize="14" FontWeight="Bold">
            <TextBlock.Effect>
                <DropShadowEffect/>
            </TextBlock.Effect><Run Text="Health:"/><LineBreak/><Run Text="Supplies:"/></TextBlock>
        <TextBlock Name="tbEvent" HorizontalAlignment="Left" Margin="37,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="538" FontWeight="Bold" FontSize="14" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect/>
            </TextBlock.Effect><Run Text="Enter Choice Below..."/>
        </TextBlock>
        <ListBox ItemsSource="{Binding LocationEvents}" x:Name="lbEvents" Margin="37,138,578,225" Background="{x:Null}" Foreground="White" SelectionChanged="lbEvents_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ChoiceText}" />
                        <Button Command="{Binding ActionToTake}" Content="{Binding ChoiceText}" Click="ChoiceButton_Click" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBox HorizontalAlignment="Left" Margin="33,311,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="143" Height="34"/>
        <Button x:Name="Submit" Content="Submit" HorizontalAlignment="Left" Margin="192,311,0,0" VerticalAlignment="Top" Height="34" Width="55" Click="Button_Click"/>

    </Grid>
</Page>
