<Page x:Class="WaywardHorizons.Grove"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WaywardHorizons"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Grove">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/The Grove.png"/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="24,17,0,0" TextWrapping="Wrap" Text="The grove" VerticalAlignment="Top" FontSize="48" FontFamily="Algerian" Foreground="White"/>
        <TextBlock HorizontalAlignment="Left" Margin="586,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="37" Width="169" FontSize="14" FontWeight="Bold" Foreground="White"><Run Text="Health"/><LineBreak/><Run Text="Supplies"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="206" Margin="33,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="367" FontWeight="Bold" FontSize="14" Foreground="White"><Run Text="Event Text Here..."/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run Text="Enter Choice Below..."/></TextBlock>
        <TextBox HorizontalAlignment="Left" Margin="33,311,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="143" Height="34"/>
        <Button x:Name="Submit" Content="Submit" HorizontalAlignment="Left" Margin="192,311,0,0" VerticalAlignment="Top" Height="34" Width="55" Click="Button_Click"/>

    </Grid>
</Page>
