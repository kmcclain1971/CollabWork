<Page x:Class="WaywardHorizons.Locations"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WaywardHorizons"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Locations">

    <Grid Background="#FFC80000">
        <Grid HorizontalAlignment="Center" Height="433" Margin="0,10,0,0" VerticalAlignment="Top" Width="611">
            <TextBlock HorizontalAlignment="Left" Margin="164,0,0,0" TextWrapping="Wrap" Text="Locations" VerticalAlignment="Top" Height="74" Width="278" FontSize="48" FontFamily="Algerian" TextAlignment="Center"/>
            <Image Margin="65,98,402,203" Source="/images/LakeLava.png" Stretch="Fill"/>
            <Image Margin="395,98,72,203" Source="/images/Forest of Winterfell.png" Stretch="Fill"/>
            <Image Margin="0,273,467,26" Source="/images/Swamp of Scarlet Rot.png" Stretch="Fill"/>
            <Image Margin="237,273,230,28" Source="/images/The Grove.png" Stretch="Fill"/>
            <Image Margin="466,275,1,26" Source="/images/Desert Valley.png" Stretch="Fill"/>
            <TextBlock HorizontalAlignment="Left" Margin="112,235,0,0" TextWrapping="Wrap" Text="Lake Lava" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Left" Margin="415,235,0,0" TextWrapping="Wrap" Text="Forest of Winterfell" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Left" Margin="16,417,0,0" TextWrapping="Wrap" Text="Swamp of Scarlet Rot" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Left" Margin="282,417,0,0" TextWrapping="Wrap" Text="The Grove" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Left" Margin="506,417,0,0" TextWrapping="Wrap" Text="Desert Valley" VerticalAlignment="Top"/>
            <Button x:Name="Lake" Content="Lake" HorizontalAlignment="Left" Margin="65,98,0,0" VerticalAlignment="Top" Height="132" Width="144" Opacity="0"/>
            <Button x:Name="Forest" Content="Forest" HorizontalAlignment="Left" Margin="395,98,0,0" VerticalAlignment="Top" Height="132" Width="144" Opacity="0"/>
            <Button x:Name="Swamp" Content="Swamp" HorizontalAlignment="Left" Margin="0,273,0,0" VerticalAlignment="Top" Height="134" Width="144" Opacity="0"/>
            <Button x:Name="Grove" Content="Grove" HorizontalAlignment="Left" Margin="237,273,0,0" VerticalAlignment="Top" Height="132" Width="144" Opacity="0"/>
            <Button x:Name="Desert" Content="Desert" HorizontalAlignment="Left" Margin="467,275,0,0" VerticalAlignment="Top" Height="132" Width="144" Opacity="0"/>

        </Grid>

    </Grid>
